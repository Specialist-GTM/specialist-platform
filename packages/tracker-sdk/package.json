{
  "name": "@specialist-gtm/tracker-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && rollup -c",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size-limit": "size-limit",
    "prepare-cdn": "node scripts/prepare-cdn.mjs",
    "clean": "node ../../scripts/clean.mjs dist coverage"
  },
  "dependencies": {
    "@specialist-gtm/crypto-utils": "workspace:*",
    "@specialist-gtm/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@size-limit/file": "catalog:",
    "@specialist-gtm/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "rollup": "catalog:",
    "size-limit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}